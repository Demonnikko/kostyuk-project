{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/show", "destination": "/show/index.html" },
    { "source": "/show/", "destination": "/show/index.html" },
    { "source": "/school", "destination": "/school/index.html" },
    { "source": "/school/", "destination": "/school/index.html" },
    { "source": "/concerts", "destination": "/concerts/index.html" },
    { "source": "/concerts/", "destination": "/concerts/index.html" }
  ],
  "redirects": [
    { "source": "/show/index.html", "destination": "/show/", "permanent": true },
    { "source": "/school/index.html", "destination": "/school/", "permanent": true },
    { "source": "/concerts/index.html", "destination": "/concerts/", "permanent": true }
  ]
}
