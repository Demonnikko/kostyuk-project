# Шаблон переменных окружения. Скопируйте в .env и заполните.
# Реальные значения в git не попадают (.env* в .gitignore).

# ── Firebase (основная БД: брони, места, билеты) ──
FIREBASE_DB_URL=
FIREBASE_SECRET=

# ── Telegram (уведомления администратору) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Админка ──
ADMIN_TOKEN=

# ── Билеты ──
TICKET_LINK_SECRET=
TICKET_PUBLIC_ORIGIN=

# ── Т-Банк (эквайринг) ──
# Тестовый терминал
TBANK_TERMINAL_KEY_TEST=
TBANK_TERMINAL_PASSWORD_TEST=
# Боевой терминал — заполнить при подключении эквайринга
TBANK_TERMINAL_KEY=
TBANK_TERMINAL_PASSWORD=
# Флаги: пока идёт настройка — тестовый режим
TBANK_HULIGAN_ENABLED=false
TBANK_HULIGAN_TEST_ENABLED=true
TBANK_FORCE_TEST_MODE=true

# ── Яндекс.Метрика ──
YM_HULIGAN_COUNTER_ID=
YM_SECRET_COUNTER_ID=

# ── Чат-ассистент ──
DEEPSEEK_API_KEY=
